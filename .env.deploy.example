# 复制为 .env.deploy 后用于生产前端构建：
#   cp .env.deploy.example .env.deploy
#   ./deploy/build-web.sh --env .env.deploy --print
#
# 这份文件只给 deploy/build-web.sh 读，不参与后端启动（后端读 .env）。
# 不要把 .env.example 直接复制成 .env.deploy：那里的 VITE_BASE=/ 是根路径模板，
# 构建脚本会拒绝它，且部署到 /rbac/ 会白屏。

VITE_BASE=/rbac/
VITE_API_BASE=/rbac/api

# 三个公开演示账号。可以直接写 VITE_DEMO_*，也可以只填服务端的 DEMO_*，
# 构建脚本会自动映射成 VITE_DEMO_*。必须与服务器 .env 里的 DEMO_* 一致，
# 否则登录页一键填入的是查无此人。口令只放公开 demo 账号。
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
DEMO_EDITOR_EMAIL=
DEMO_EDITOR_PASSWORD=
DEMO_VIEWER_EMAIL=
DEMO_VIEWER_PASSWORD=
