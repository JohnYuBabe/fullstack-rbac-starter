# 复制为 .env 后使用。所有 CHANGE_ME_* 都必须替换。
# 生成口令用 hex（不含 @ : / 等会破坏 DATABASE_URL 的字符）：openssl rand -hex 24

# ---------- MySQL (docker compose) ----------
MYSQL_ROOT_PASSWORD=CHANGE_ME_MYSQL_ROOT
MYSQL_DATABASE=rbac_starter
MYSQL_USER=rbac
MYSQL_PASSWORD=CHANGE_ME_MYSQL_APP

# 宿主机直连（compose 只把 3306 映射到 127.0.0.1:3309，与同机的其它项目错开）
# 注意：prisma migrate dev 需要创建 shadow database，而 compose 里的 rbac 用户只有单库权限；
# 首次建迁移时改用 root 连接，或改用 prisma:deploy 应用已有迁移。
DATABASE_URL="mysql://rbac:CHANGE_ME_MYSQL_APP@localhost:3309/rbac_starter"

# ---------- Server ----------
# 本地开发端口（生产容器内部固定 3000，由 compose 映射到 127.0.0.1:3020）
PORT=3020
# 生产要求 >= 32 位且不含 change-me/dev-secret/example/test-secret 等字样
JWT_SECRET=CHANGE_ME_32_BYTES_OR_LONGER
JWT_EXPIRES_IN=12h
# 同源部署留空；多域名用逗号分隔
CORS_ORIGINS=
RATE_LIMIT_PER_MINUTE=120

# ---------- Seed ----------
# 生产默认两项都为 false：不写演示数据。
# 需要重建演示库时，把两项同时设为 true 再重启 server。
SEED_ON_START=false
ALLOW_DEMO_SEED=false

# 私有管理员：密码不公开、不进前端 bundle。生产至少 16 位。
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_ADMIN_16_CHARS_MIN

# 三个公开演示账号：密码会被 VITE_DEMO_* 打进前端 bundle，站点因此对所有人可写。
# 不要把真实数据放进演示库。生产每项至少 12 位。
DEMO_ADMIN_EMAIL=demo-admin@example.com
DEMO_ADMIN_PASSWORD=CHANGE_ME_DEMO_ADMIN_12
DEMO_EDITOR_EMAIL=demo-editor@example.com
DEMO_EDITOR_PASSWORD=CHANGE_ME_DEMO_EDITOR_12
DEMO_VIEWER_EMAIL=demo-viewer@example.com
DEMO_VIEWER_PASSWORD=CHANGE_ME_DEMO_VIEWER_12

# ---------- Web ----------
# 子路径部署：VITE_BASE=/rbac/、VITE_API_BASE=/rbac/api
VITE_BASE=/
VITE_API_BASE=/api
# 留空则登录页不显示一键填充按钮。填写后这些口令会进 bundle，只能放公开的 demo 账号。
VITE_DEMO_ADMIN_EMAIL=
VITE_DEMO_ADMIN_PASSWORD=
VITE_DEMO_EDITOR_EMAIL=
VITE_DEMO_EDITOR_PASSWORD=
VITE_DEMO_VIEWER_EMAIL=
VITE_DEMO_VIEWER_PASSWORD=
